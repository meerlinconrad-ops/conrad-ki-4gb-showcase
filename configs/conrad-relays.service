[Unit]
Description=Conrad KI Unified Rust Relays (:3010, :3050, :3051, :5005, :8080)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/conrad-relays/imap.env
ExecStart=/usr/local/bin/conrad-relays --mode all --bind-addrs 127.0.0.1,172.17.0.1,172.19.0.1
Restart=always
RestartSec=2
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
